generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  username         String             @unique
  password         String?
  fullName         String?
  avatar           String?
  bio              String?
  website          String?
  location         String?
  totalCredits     Int                @default(100)
  lastCreditUpdate DateTime           @default(now())
  emailVerified    Boolean            @default(false)
  googleId         String?            @unique
  facebookId       String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  role             String             @default("USER")
  referredBy       AffiliateReferral?
  affiliate        Affiliate?
  cartOrders       CartOrder[]
  cartSessions     CartSession[]
  credits          Credit[]
  favorites        Favorite[]
  generations      Generation[]
  images           Image[]
  paymentIntents   PaymentIntent[]
  payments         Payment[]
  subscription     Subscription?

  @@index([createdAt(sort: Desc)])
  @@index([role])
  @@index([totalCredits])
  @@map("colibrrri_users")
}

model Subscription {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  plan                    String    @default("FREE")
  status                  String    @default("ACTIVE")
  currentPeriodEnd        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  cancelledAt             DateTime?
  wayforpayOrderReference String?
  isRecurring             Boolean   @default(false)
  recurringToken          String?
  recurringMode           String?
  nextPaymentDate         DateTime?
  lastPaymentDate         DateTime?
  failedPaymentAttempts   Int       @default(0)
  maxFailedAttempts       Int       @default(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextPaymentDate])
  @@index([plan])
  @@map("colibrrri_subscriptions")
}

model Credit {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("colibrrri_credits")
}

model PaymentIntent {
  id             String    @id @default(cuid())
  trackingId     String    @unique
  orderReference String?   @unique
  userId         String
  planId         String
  language       String    @default("en")
  status         String    @default("INITIATED")
  wayforpayData  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("colibrrri_payment_intents")
}

model Image {
  id             String     @id @default(cuid())
  userId         String
  url            String
  thumbnailUrl   String?
  cloudPath      String?
  prompt         String
  negativePrompt String?
  model          String
  style          String?
  width          Int
  height         Int
  seed           Int?
  steps          Int?
  guidance       Float?
  isPublic       Boolean    @default(false)
  likes          Int        @default(0)
  views          Int        @default(0)
  createdAt      DateTime   @default(now())
  generationId   String
  favorites      Favorite[]
  generation     Generation @relation(fields: [generationId], references: [id])
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           Tag[]      @relation("ImageToTag")

  @@index([userId, createdAt(sort: Desc)])
  @@index([model])
  @@index([isPublic, likes(sort: Desc)])
  @@index([isPublic, createdAt(sort: Desc)])
  @@index([generationId])
  @@map("colibrrri_images")
}

model Generation {
  id             String    @id @default(cuid())
  userId         String
  prompt         String
  negativePrompt String?
  model          String
  style          String?
  batchSize      Int       @default(1)
  status         String    @default("PENDING")
  error          String?
  creditsUsed    Int
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  images         Image[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([model, createdAt(sort: Desc)])
  @@map("colibrrri_generations")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  createdAt DateTime @default(now())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  @@index([imageId])
  @@map("colibrrri_favorites")
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  amount                  Float
  currency                String   @default("USD")
  status                  String
  description             String?
  createdAt               DateTime @default(now())
  wayforpayOrderReference String?  @unique
  cartItems               String?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("colibrrri_payments")
}

model CartOrder {
  id                 String    @id @default(cuid())
  orderReference     String    @unique
  userId             String?
  amount             Float
  currency           String    @default("UAH")
  paymentStatus      String    @default("PENDING")
  transactionStatus  String?
  reasonCode         String?
  authCode           String?
  cardPan            String?
  customerEmail      String?
  customerFirstName  String?
  customerLastName   String?
  customerPhone      String?
  customerAddress    String?
  customerCity       String?
  customerCountry    String?
  shippingFirstName  String?
  shippingLastName   String?
  shippingPhone      String?
  shippingAddress    String?
  shippingCity       String?
  shippingCountry    String?
  shippingPostalCode String?
  items              String
  orderStatus        String    @default("PENDING")
  trackingNumber     String?
  trackingCarrier    String?
  adminNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  paidAt             DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  user               User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerEmail])
  @@map("colibrrri_cart_orders")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  images    Image[]  @relation("ImageToTag")

  @@map("colibrrri_tags")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("colibrrri_sessions")
}

model CartSession {
  id                 String    @id @default(cuid())
  sessionId          String    @unique
  userId             String?
  items              String
  totalAmount        Float
  itemCount          Int
  currency           String    @default("UAH")
  customerEmail      String?
  status             String    @default("active")
  userIp             String?
  userAgent          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastActivityAt     DateTime  @default(now())
  abandonedAt        DateTime?
  convertedToOrderId String?
  user               User?     @relation(fields: [userId], references: [id])

  @@index([status, abandonedAt])
  @@index([userId])
  @@map("colibrrri_cart_sessions")
}

model Affiliate {
  id             String                @id @default(cuid())
  userId         String                @unique
  code           String                @unique
  commissionRate Float                 @default(20.0)
  totalEarnings  Float                 @default(0.0)
  pendingPayouts Float                 @default(0.0)
  paidAmount     Float                 @default(0.0)
  payoutMethod   String?
  payoutDetails  String?
  status         String                @default("active")
  tier           String                @default("starter")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  clicks         AffiliateClick[]
  commissions    AffiliateCommission[]
  links          AffiliateLink[]
  payouts        AffiliatePayout[]
  referrals      AffiliateReferral[]
  dailyStats     AffiliateStatDaily[]
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([status])
  @@map("colibrrri_affiliates")
}

model AffiliateLink {
  id              String              @id @default(cuid())
  affiliateId     String
  alias           String?             @unique
  url             String
  clickCount      Int                 @default(0)
  conversionCount Int                 @default(0)
  isDefault       Boolean             @default(false)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  clicks          AffiliateClick[]
  affiliate       Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referrals       AffiliateReferral[]

  @@index([affiliateId])
  @@index([isActive])
  @@map("colibrrri_affiliate_links")
}

model AffiliateClick {
  id          String             @id @default(cuid())
  linkId      String?
  affiliateId String
  sessionId   String?
  ipAddress   String?
  userAgent   String?
  referer     String?
  landingPage String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  country     String?
  city        String?
  deviceType  String?
  createdAt   DateTime           @default(now())
  subId       String?
  affiliate   Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link        AffiliateLink?     @relation(fields: [linkId], references: [id])
  referral    AffiliateReferral?

  @@index([affiliateId])
  @@index([createdAt])
  @@index([sessionId])
  @@map("colibrrri_affiliate_clicks")
}

model AffiliateReferral {
  id               String                @id @default(cuid())
  affiliateId      String
  userId           String                @unique
  linkId           String?
  clickId          String?               @unique
  status           String                @default("signup")
  lifetimeValue    Float                 @default(0.0)
  firstPaymentDate DateTime?
  lastPaymentDate  DateTime?
  conversionDate   DateTime?
  createdAt        DateTime              @default(now())
  commissions      AffiliateCommission[]
  affiliate        Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  click            AffiliateClick?       @relation(fields: [clickId], references: [id])
  link             AffiliateLink?        @relation(fields: [linkId], references: [id])
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@map("colibrrri_affiliate_referrals")
}

model AffiliateCommission {
  id             String            @id @default(cuid())
  affiliateId    String
  referralId     String
  orderId        String?
  type           String            @default("sale")
  amount         Float
  baseAmount     Float
  commissionRate Float
  currency       String            @default("USD")
  status         String            @default("pending")
  approvedAt     DateTime?
  paidAt         DateTime?
  payoutId       String?
  notes          String?
  createdAt      DateTime          @default(now())
  affiliate      Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payout         AffiliatePayout?  @relation(fields: [payoutId], references: [id])
  referral       AffiliateReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@index([payoutId])
  @@map("colibrrri_affiliate_commissions")
}

model AffiliatePayout {
  id            String                @id @default(cuid())
  affiliateId   String
  amount        Float
  currency      String                @default("USD")
  method        String
  transactionId String?
  status        String                @default("pending")
  notes         String?
  invoiceNumber String?
  processedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  commissions   AffiliateCommission[]
  affiliate     Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@map("colibrrri_affiliate_payouts")
}

model AffiliateStatDaily {
  id           String    @id @default(cuid())
  affiliateId  String
  date         DateTime
  clicks       Int       @default(0)
  uniqueClicks Int       @default(0)
  signups      Int       @default(0)
  customers    Int       @default(0)
  revenue      Float     @default(0.0)
  commissions  Float     @default(0.0)
  createdAt    DateTime  @default(now())
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, date])
  @@index([date])
  @@index([affiliateId])
  @@map("colibrrri_affiliate_stats_daily")
}
