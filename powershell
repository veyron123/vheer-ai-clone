#!/bin/bash
# Lightweight stub to mimic the kill-ports.ps1 PowerShell script under WSL.
if echo "$*" | grep -q "kill-ports.ps1"; then
  echo "Освобождаем порты 5000 и 5178..."
  for port in 5000 5178; do
    pid=$(lsof -t -i :"$port" 2>/dev/null | head -n 1)
    if [ -n "$pid" ]; then
      echo "Закрываем процесс $pid на порту $port"
      kill -9 "$pid" 2>/dev/null || true
    else
      echo "Порт $port свободен"
    fi
  done
  echo "Порты освобождены!"
  exit 0
fi

echo "powershell stub: unsupported invocation $*" >&2
exit 0
